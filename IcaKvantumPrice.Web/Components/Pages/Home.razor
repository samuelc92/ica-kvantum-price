@page "/"

<PageTitle>Home</PageTitle>

<h1>Products percentages prices</h1>

<FluentDataGrid Items="@_report">
    <PropertyColumn Property="@(p => p.ProductIdentifier)" Title="Identifier" Sortable="false" />
    <PropertyColumn Property="@(p => p.Description)" Sortable="true" />
    <PropertyColumn Property="@(p => p.PorcentageFormatted)" Title="Percent" Sortable="false" />
</FluentDataGrid>
